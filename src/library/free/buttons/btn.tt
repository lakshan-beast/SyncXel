      whileTap={{ scale: 0.95 }}
      className="px-6 py-2 bg-green-950 border border-green-500 text-green-300 font-mono text-xs rounded tracking-widest uppercase shadow-[0_0_15px_rgba(34,197,94,0.4)] cursor-pointer"
