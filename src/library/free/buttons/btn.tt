    <motion.button
      whileTap={{ scale: 0.96, boxShadow: "inset 4px 4px 8px #020617, inset -4px -4px 8px #1e293b" }}
      className="px-6 py-3 bg-slate-900 text-indigo-300 font-baloo text-xs font-bold rounded-2xl shadow-[6px_6px_12px_#020617,-6px_-6px_12px_#1e293b] border border-slate-800 cursor-pointer"
    >
      VOLUMETRIC_PUSH
    </motion.button>
  );
}

```

