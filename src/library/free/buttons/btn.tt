**7. Bento Grid Action Tile (`BentoActionTile.jsx`)**

```javascript
import { motion } from "framer-motion";

export default function BentoActionTile() {
  return (
    <motion.button
      whileHover={{ scale: 1.03, backgroundColor: "#1e293b" }}
      className="px-5 py-3 bg-slate-900 border border-slate-800 text-slate-200 font-baloo text-xs font-bold rounded-2xl flex items-center gap-3 shadow-lg cursor-pointer"
    >
      <span className="w-2 h-2 rounded-full bg-cyan-400 animate-ping" />
      <span>BENTO_CLUSTER</span>
    </motion.button>
  );
}

```

