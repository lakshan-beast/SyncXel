import React, { useState, useEffect } from "react";
import { HiStar, HiChevronLeft, HiChevronRight, HiCheckCircle } from "react-icons/hi";

export default function ReviewSlider() {
  const reviews = [
    {
      id: 1,
      name: "Kasun Perera",
      role: "Frontend Developer",
      comment: "Syncxel saved me tons of hours building my agency portfolio. The copy-paste feature is an absolute lifesaver!",
      rating: 5,
    },
    {
      id: 2,
      name: "Sarah Johnson",
      role: "SaaS Founder",
      comment: "Clean Tailwind code and the templates are gorgeous. Worth every penny for the Pro kit.",
      rating: 5,
    },
    {
      id: 3,
      name: "Ahamed Rza",
      role: "Freelancer",
      comment: "The dark mode support and smooth animations make my client projects look top-notch and modern.",
      rating: 5,
    },
    {
      id: 4,
      name: "Nimesh Silva",
      role: "UI/UX Designer",
      comment: "The typography and spacing in these components are spot on. Very easy to customize.",
      rating: 5,
    },
    {
      id: 5,
      name: "Emily Watson",
      role: "Fullstack Dev",
      comment: "I used the photographer template and customized it in 2 hours. My client loved it!",
      rating: 5,
    },
    {
      id: 6,
      name: "Charith Mendis",
      role: "React Student",
      comment: "Best resource for learning how production-ready components are structured. Highly recommended!",
      rating: 5,
    },
  ];

  const [currentIndex, setCurrentIndex] = useState(0);

  // Auto slide every 4 seconds
  useEffect(() => {
    const timer = setInterval(() => {
      setCurrentIndex((prevIndex) => (prevIndex + 1) % reviews.length);
    }, 4000);
    return () => clearInterval(timer);
  }, [reviews.length]);

  const prevSlide = () => {
    setCurrentIndex((prevIndex) => (prevIndex === 0 ? reviews.length - 1 : prevIndex - 1));
  };

  const nextSlide = () => {
    setCurrentIndex((prevIndex) => (prevIndex + 1) % reviews.length);
  };

  return (
    <section className="py-12 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto my-10">
      
      {/* Section Header */}
      <div className="text-center mb-8">
        <span className="text-xs font-bold text-cyan-400 uppercase tracking-widest bg-cyan-500/10 px-3 py-1 rounded-full border border-cyan-500/20">
          Wall of Love
        </span>
        <h2 className="text-2xl sm:text-3xl font-bold text-white mt-3">
          What developers are saying
        </h2>
      </div>

      {/* Slider Container */}
      <div className="relative bg-slate-900/40 border border-slate-800 rounded-2xl p-6 sm:p-10 shadow-2xl backdrop-blur-sm overflow-hidden">
        
        {/* Review Card Content */}
        <div className="transition-all duration-500 ease-in-out min-h-[140px] flex flex-col justify-between">
          <div>
            {/* Stars */}
            <div className="flex items-center space-x-1 mb-4 text-amber-400">
              {[...Array(reviews[currentIndex].rating)].map((_, i) => (
                <HiStar key={i} className="w-5 h-5 fill-amber-400" />
              ))}
            </div>
            
            <p className="text-sm sm:text-base text-slate-200 leading-relaxed italic">
              "{reviews[currentIndex].comment}"
            </p>
          </div>

          {/* Author Details */}
          <div className="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between">
            <div className="flex items-center space-x-3">
              <div className="w-10 h-10 rounded-full bg-cyan-500/20 border border-cyan-500/30 flex items-center justify-center text-cyan-400 font-bold text-sm">
                {reviews[currentIndex].name.charAt(0)}
              </div>
              <div>
                <h5 className="text-xs sm:text-sm font-bold text-white flex items-center gap-1.5">
                  {reviews[currentIndex].name}
                  <HiCheckCircle className="w-4 h-4 text-cyan-400" title="Verified" />
                </h5>
                <span className="text-[11px] text-slate-400">{reviews[currentIndex].role}</span>
              </div>
            </div>

            {/* Pagination Indicators */}
            <div className="text-xs text-slate-500 font-mono">
              0{currentIndex + 1} / 0{reviews.length}
            </div>
          </div>
        </div>

        {/* Navigation Buttons */}
        <div className="absolute inset-y-0 left-2 flex items-center">
          <button 
            onClick={prevSlide}
            className="p-2 rounded-full bg-slate-950/80 border border-slate-800 text-slate-400 hover:text-white hover:bg-slate-800 transition-all shadow-md"
            aria-label="Previous Review"
          >
            <HiChevronLeft className="w-5 h-5" />
          </button>
        </div>
        <div className="absolute inset-y-0 right-2 flex items-center">
          <button 
            onClick={nextSlide}
            className="p-2 rounded-full bg-slate-950/80 border border-slate-800 text-slate-400 hover:text-white hover:bg-slate-800 transition-all shadow-md"
            aria-label="Next Review"
          >
            <HiChevronRight className="w-5 h-5" />
          </button>
        </div>

      </div>

      {/* Dots / Bullets */}
      <div className="flex justify-center space-x-2 mt-6">
        {reviews.map((_, idx) => (
          <button
            key={idx}
            onClick={() => setCurrentIndex(idx)}
            className={`h-2 rounded-full transition-all ${currentIndex === idx ? "w-6 bg-cyan-400" : "w-2 bg-slate-800 hover:bg-slate-700"}`}
            aria-label={`Go to slide ${idx + 1}`}
          />
        ))}
      </div>

    </section>
  );
}