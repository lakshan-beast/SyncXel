            >
              <HiOutlineCodeBracket className="w-4 h-4 text-syncxel-cyan" />
              <span>Hire Us for Custom Project</span>
            </a>
          </div>
        </div>

        {/* 🌟 3. HERO INTERACTIVE CODE & PREVIEW BOX WITH FLOATING BADGES */}
        <div className="relative max-w-4xl mx-auto">
          
          {/* FLOATING BADGE 1 (Left) */}
          <div className="hidden lg:flex absolute -left-12 top-10 z-20 items-center space-x-3 p-3 rounded-2xl bg-syncxel-card/90 border border-syncxel-border/80 backdrop-blur-md shadow-2xl animate-bounce duration-1000">
            <div className="w-8 h-8 rounded-lg bg-syncxel-cyan/10 border border-syncxel-cyan/30 flex items-center justify-center">
              <HiOutlineCpuChip className="w-5 h-5 text-syncxel-cyan" />
            </div>
            <div>
              <div className="text-xs font-bold text-white">Ultra Scalable</div>
              <div className="text-[10px] text-syncxel-textMuted">Pure React Code</div>
            </div>
          </div>

          {/* FLOATING BADGE 2 (Right) */}
          <div className="hidden lg:flex absolute -right-12 bottom-12 z-20 items-center space-x-3 p-3 rounded-2xl bg-syncxel-card/90 border border-syncxel-border/80 backdrop-blur-md shadow-2xl animate-pulse">
            <div className="w-8 h-8 rounded-lg bg-syncxel-blue/10 border border-syncxel-blue/30 flex items-center justify-center">
              <HiOutlineLightningBolt className="w-5 h-5 text-syncxel-cyan" />
            </div>
            <div>
              <div className="text-xs font-bold text-white">100/100 Speed</div>
              <div className="text-[10px] text-syncxel-textMuted">Lighthouse Score</div>
            </div>
          </div>

          {/* MAIN CODE WINDOW */}
          <div className="rounded-2xl bg-syncxel-card/90 border border-syncxel-border/80 shadow-2xl overflow-hidden backdrop-blur-xl">
            {/* Header Bar */}
            <div className="flex items-center justify-between px-4 py-3 bg-syncxel-dark/95 border-b border-syncxel-border/60">
              {/* Window Dots */}
              <div className="flex items-center space-x-2">
                <span className="w-3 h-3 rounded-full bg-red-500/80 inline-block" />
                <span className="w-3 h-3 rounded-full bg-yellow-500/80 inline-block" />
                <span className="w-3 h-3 rounded-full bg-green-500/80 inline-block" />
                <span className="text-xs text-syncxel-textMuted font-mono ml-2 hidden sm:inline-block">
                  SyncXelComponent.jsx
                </span>
              </div>

              {/* Tabs & Copy Button */}
              <div className="flex items-center space-x-3">
                <div className="flex bg-syncxel-card p-1 rounded-lg border border-syncxel-border/60 text-xs">
                  <button
