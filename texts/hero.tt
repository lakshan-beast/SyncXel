                >
                  {copied ? (
                    <HiOutlineCheck className="w-4 h-4 text-green-400" />
                  ) : (
                    <HiOutlineClipboardDocument className="w-4 h-4" />
                  )}
                </button>
              </div>
            </div>

            {/* Tab Content Box */}
            <div className="p-8 sm:p-12 min-h-[220px] flex items-center justify-center bg-[#080b12] relative overflow-hidden">
              {/* Glowing accent inside preview */}
              <div className="absolute inset-0 bg-gradient-to-r from-syncxel-cyan/5 via-transparent to-syncxel-blue/5 pointer-events-none" />

